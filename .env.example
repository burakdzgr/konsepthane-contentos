# ContentOS local development environment - SAFE DEVELOPMENT DEFAULTS ONLY.
# Copy this file to .env for docker compose and local tooling.
# Never put real, shared, or production credentials here or in .env.
# ContentOS uses its own dedicated database; never reference Konsepthane values.

# Runtime identity
CONTENTOS_ENVIRONMENT=local
CONTENTOS_SERVICE_NAME=Konsepthane ContentOS
CONTENTOS_APPLICATION_VERSION=0.1.0
CONTENTOS_LOG_LEVEL=INFO
CONTENTOS_API_DOCS_ENABLED=true

# PostgreSQL Compose service (development-only local credentials)
CONTENTOS_POSTGRES_USER=contentos
CONTENTOS_POSTGRES_PASSWORD=contentos-dev-password
CONTENTOS_POSTGRES_DB=contentos
CONTENTOS_POSTGRES_HOST_PORT=55432

# Redis Compose service
CONTENTOS_REDIS_HOST_PORT=56379

# API Compose service
CONTENTOS_API_HOST_PORT=8000

# Admin Compose service
CONTENTOS_ADMIN_PORT=3000

# Internal FastAPI URL for the admin server (server-side only, never sent to
# the browser). Host-side admin development (pnpm dev) uses 127.0.0.1; the
# containerized admin is configured with http://api:8000 inside compose.yaml.
CONTENTOS_INTERNAL_API_URL=http://127.0.0.1:8000

# Backend settings for running the backend directly on the host (uv run ...).
# Compose containers construct their own service-internal URLs and ignore these.
CONTENTOS_DATABASE_URL=postgresql+psycopg://contentos:contentos-dev-password@127.0.0.1:55432/contentos
CONTENTOS_DB_POOL_SIZE=5
CONTENTOS_DB_POOL_TIMEOUT_SECONDS=30
CONTENTOS_DB_CONNECT_TIMEOUT_SECONDS=10
CONTENTOS_REDIS_BROKER_URL=redis://127.0.0.1:56379/0
CONTENTOS_REDIS_RESULT_URL=redis://127.0.0.1:56379/1
CONTENTOS_CELERY_DEFAULT_QUEUE=contentos.default
CONTENTOS_CELERY_TASK_ALWAYS_EAGER=false
CONTENTOS_CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP=true
CONTENTOS_CELERY_BROKER_CONNECTION_TIMEOUT_SECONDS=10
CONTENTOS_CELERY_RESULT_EXPIRES_SECONDS=3600

# OpenAI adapter (optional; ONLY needed when using the OpenAI provider).
# Leave unset by default — every non-OpenAI feature works without a key.
# Never put a real key in this file or in .env you might share.
# Without BOTH values every AI command (fikir üret, taslak, editör, brief) is
# refused at the API with a clear notice; compose passes them into api+worker.
# CONTENTOS_OPENAI_API_KEY=
# CONTENTOS_OPENAI_MODEL=gpt-4o-mini

# Subcontractor AI gateway (ADR 0011) — the self-hosted browser gateway from
# github.com/OktayCennetoglu/subcontractor-ai. Set the provider to
# `subcontractor` and point at the gateway (from inside Docker the host
# machine is host.docker.internal). The key is a `ksk_live_...` customer key
# created with `npm run keys -- create` on the gateway; models: chatgpt,
# claude, ... (image jobs need a model that produces images, e.g. chatgpt).
# CONTENTOS_AI_PROVIDER=subcontractor
# CONTENTOS_SUBCONTRACTOR_BASE_URL=http://host.docker.internal:8090
# CONTENTOS_SUBCONTRACTOR_API_KEY=ksk_live_...
# CONTENTOS_SUBCONTRACTOR_MODEL=chatgpt
# CONTENTOS_SUBCONTRACTOR_IMAGE_MODEL=chatgpt
# CONTENTOS_SUBCONTRACTOR_TIMEOUT_SECONDS=420
# Gateway ADMIN_TOKEN (its .docker.env) so the live operations page can show
# accounts, queue depth and the running job's phase; server-side only.
# CONTENTOS_SUBCONTRACTOR_ADMIN_TOKEN=
# CONTENTOS_OPENAI_TIMEOUT_SECONDS=60


# Base URL of the Konsepthane Publishing API (ends before /v1/...):
# host runs use http://localhost:4000/internal/contentos, containers use
# http://host.docker.internal:4000/internal/contentos (prod: the deployed base).
CONTENTOS_PUBLISHING_API_URL=
# Dedicated service token issued by Konsepthane (secret; set it ONLY in .env).
CONTENTOS_PUBLISHING_API_KEY=

# Performance loop (agent E): classifier thresholds and the beat schedule.
CONTENTOS_PERFORMANCE_SCHEDULE_ENABLED=true
CONTENTOS_PERFORMANCE_SYNC_HOUR_UTC=3
CONTENTOS_PERFORMANCE_LEARN_HOUR_UTC=4
CONTENTOS_PERFORMANCE_MARKET_INTERVAL_HOURS=24
CONTENTOS_PERFORMANCE_MIN_IMPRESSIONS=100
CONTENTOS_PERFORMANCE_MIN_DAYS=7
CONTENTOS_PERFORMANCE_DECLINE_PCT=0.25
CONTENTOS_PERFORMANCE_RISE_PCT=0.25
CONTENTOS_PERFORMANCE_VOLATILITY_PCT=0.5

# --- External intelligence providers (Entegrasyonlar screen) ---
# All optional. Leave unset and the provider shows "Yapılandırılmadı" /
# "API erişimi gerekli"; the rest of ContentOS keeps working. Never commit
# real values. See docs/INTEGRATIONS.md for the full setup walkthrough.
#
# Semrush Analytics API v3: the API key from your Semrush account
# (Profile > Subscription info > API units / API key). Requires a Business
# plan with API units. Database = Semrush country database, e.g. tr, us.
# CONTENTOS_SEMRUSH_API_KEY=
# CONTENTOS_SEMRUSH_DATABASE=tr
# CONTENTOS_SEMRUSH_DAILY_BUDGET=200
# CONTENTOS_SEMRUSH_CACHE_HOURS=72
#
# Google service account (Search Console + GA4): create a service account
# in Google Cloud, download its JSON key, then paste the JSON content OR a
# path to the file (mounted into the containers). Add the service account
# e-mail to the Search Console property (Full or Restricted) and to the GA4
# property as Viewer.
# CONTENTOS_GOOGLE_SERVICE_ACCOUNT_JSON=
# Search Console property exactly as listed in Search Console:
# https://konsepthane.net/ (URL prefix) or sc-domain:konsepthane.net
# CONTENTOS_GSC_SITE_URL=
# CONTENTOS_GSC_DAILY_BUDGET=500
# CONTENTOS_GSC_CACHE_HOURS=12
# GA4 property id (numeric, from GA Admin > Property settings), e.g. 123456789
# CONTENTOS_GA4_PROPERTY_ID=
# Comma-separated GA4 key event names to report (only events that exist).
# CONTENTOS_GA4_KEY_EVENTS=
# CONTENTOS_GA4_DAILY_BUDGET=500
# CONTENTOS_GA4_CACHE_HOURS=12
#
# Google Trends: there is no generally available official API. Set the key
# only when Google grants (alpha/allow-listed) API access; the adapter is
# inactive otherwise and trends.google.com is never scraped.
# CONTENTOS_GOOGLE_TRENDS_API_KEY=
# CONTENTOS_GOOGLE_TRENDS_API_URL=
# CONTENTOS_GOOGLE_TRENDS_DAILY_BUDGET=200
# CONTENTOS_GOOGLE_TRENDS_CACHE_HOURS=24
#
# Google Trends — BigQuery Public Dataset (bigquery-public-data.google_trends):
# Türkiye's daily Top / Rising search-term sets as a first-party trend
# DISCOVERY source (usable today, no alpha access needed). Reuses the same
# service-account key; grant that account only "BigQuery Job User" on the
# Google Cloud project and enable the BigQuery API there. The project id is
# read from the key file; set it explicitly only if it differs.
# CONTENTOS_GOOGLE_CLOUD_PROJECT_ID=
# CONTENTOS_GOOGLE_TRENDS_BIGQUERY_COUNTRY=TR
# CONTENTOS_GOOGLE_TRENDS_BIGQUERY_DAILY_BUDGET=20
# CONTENTOS_GOOGLE_TRENDS_BIGQUERY_CACHE_HOURS=24
# Hard cap per query (bytes); a partition-bound TR day is far below this.
# CONTENTOS_GOOGLE_TRENDS_BIGQUERY_MAX_BYTES_BILLED=2000000000
# Daily sync hour (UTC); the sync is idempotent per refresh date.
# CONTENTOS_GOOGLE_TRENDS_BIGQUERY_SYNC_HOUR_UTC=15
#
# Pinterest API v5 Trends: create an app at developers.pinterest.com, request
# the trends:read scope and generate an access token for it.
# CONTENTOS_PINTEREST_ACCESS_TOKEN=
# CONTENTOS_PINTEREST_REGION=TR
# CONTENTOS_PINTEREST_DAILY_BUDGET=200
# CONTENTOS_PINTEREST_CACHE_HOURS=24
#
# HTTP timeout for every provider call (seconds).
# CONTENTOS_INTEGRATIONS_HTTP_TIMEOUT_SECONDS=20
