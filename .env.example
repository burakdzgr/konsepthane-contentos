# ContentOS local development environment - SAFE DEVELOPMENT DEFAULTS ONLY.
# Copy this file to .env for docker compose and local tooling.
# Never put real, shared, or production credentials here or in .env.
# ContentOS uses its own dedicated database; never reference Konsepthane values.

# Runtime identity
CONTENTOS_ENVIRONMENT=local
CONTENTOS_SERVICE_NAME=Konsepthane ContentOS
CONTENTOS_APPLICATION_VERSION=0.1.0
CONTENTOS_LOG_LEVEL=INFO
CONTENTOS_API_DOCS_ENABLED=true

# PostgreSQL Compose service (development-only local credentials)
CONTENTOS_POSTGRES_USER=contentos
CONTENTOS_POSTGRES_PASSWORD=contentos-dev-password
CONTENTOS_POSTGRES_DB=contentos
CONTENTOS_POSTGRES_HOST_PORT=55432

# Redis Compose service
CONTENTOS_REDIS_HOST_PORT=56379

# API Compose service
CONTENTOS_API_HOST_PORT=8000

# Admin Compose service
CONTENTOS_ADMIN_PORT=3000

# Internal FastAPI URL for the admin server (server-side only, never sent to
# the browser). Host-side admin development (pnpm dev) uses 127.0.0.1; the
# containerized admin is configured with http://api:8000 inside compose.yaml.
CONTENTOS_INTERNAL_API_URL=http://127.0.0.1:8000

# Backend settings for running the backend directly on the host (uv run ...).
# Compose containers construct their own service-internal URLs and ignore these.
CONTENTOS_DATABASE_URL=postgresql+psycopg://contentos:contentos-dev-password@127.0.0.1:55432/contentos
CONTENTOS_DB_POOL_SIZE=5
CONTENTOS_DB_POOL_TIMEOUT_SECONDS=30
CONTENTOS_DB_CONNECT_TIMEOUT_SECONDS=10
CONTENTOS_REDIS_BROKER_URL=redis://127.0.0.1:56379/0
CONTENTOS_REDIS_RESULT_URL=redis://127.0.0.1:56379/1
CONTENTOS_CELERY_DEFAULT_QUEUE=contentos.default
CONTENTOS_CELERY_TASK_ALWAYS_EAGER=false
CONTENTOS_CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP=true
CONTENTOS_CELERY_BROKER_CONNECTION_TIMEOUT_SECONDS=10
CONTENTOS_CELERY_RESULT_EXPIRES_SECONDS=3600

# OpenAI adapter (optional; ONLY needed when using the OpenAI provider).
# Leave unset by default — every non-OpenAI feature works without a key.
# Never put a real key in this file or in .env you might share.
# CONTENTOS_OPENAI_API_KEY=
# CONTENTOS_OPENAI_MODEL=
# CONTENTOS_OPENAI_TIMEOUT_SECONDS=60


# Base URL of the Konsepthane Publishing API (ends before /v1/...):
# host runs use http://localhost:4000/internal/contentos, containers use
# http://host.docker.internal:4000/internal/contentos (prod: the deployed base).
CONTENTOS_PUBLISHING_API_URL=
# Dedicated service token issued by Konsepthane (secret; set it ONLY in .env).
CONTENTOS_PUBLISHING_API_KEY=